        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up{job=~\"spring-services|eureka-server\"}, application)",
          "refId": "application"
        },
        "definition": "label_values(up{job=~\"spring-services|eureka-server\"}, application)",
