# =============================================================================
# 이 파일을 .env 로 복사한 뒤 값을 채움
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS)
#
# .env 는 gitignore 되어 있으므로 각자 로컬에서 만들어야 함
# 값에 따옴표를 붙이거나 끝에 공백을 두지 말 것, 그대로 값의 일부가 됨
# =============================================================================

# -----------------------------------------------------------------------------
# 기본으로 켤 프로파일
# -----------------------------------------------------------------------------
# 이 값이 있으면 docker compose up -d 만으로 아래 조합이 뜸
# 다른 조합이 필요하면 명령에 --profile 을 직접 붙이며 그쪽이 우선함
COMPOSE_PROFILES=infra,tools

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# 슈퍼유저이며 init 스크립트가 이 계정으로 DB 와 서비스 계정을 만듦
POSTGRES_USER=pawtrail
POSTGRES_PASSWORD=CHANGE_ME

# 서비스 전용 계정 10개가 공유하는 비밀번호임
# 계정을 나눈 목적은 누가 어느 DB 에 붙을 수 있는가를 권한으로 막는 것이지
# 비밀번호를 따로 두는 것이 아니므로 로컬에서는 하나로 둠
#
# 이 값은 init-db/01-databases.sh 가 계정을 만들 때 쓰임
# 스크립트에 비밀번호를 직접 적지 않는 이유는 .env 를 고쳤는데 스크립트 안 리터럴이
# 그대로 남아 두 값이 갈리는 사고를 원천 차단하기 위함임
SERVICE_DB_PASSWORD=CHANGE_ME
