# =============================================================================
# 이 파일을 .env 로 복사한 뒤 값을 채움
#   copy .env.example .env      (Windows)
#   cp .env.example .env        (macOS)
#
# .env 는 gitignore 되어 있으므로 각자 로컬에서 만들어야 함
# 값에 따옴표를 붙이거나 끝에 공백을 두지 말 것, 그대로 값의 일부가 됨
# =============================================================================

# -----------------------------------------------------------------------------
# 기본으로 켤 프로파일
# -----------------------------------------------------------------------------
# 이 값이 있으면 docker compose up -d 만으로 아래 조합이 뜸
# 다른 조합이 필요하면 명령에 --profile 을 직접 붙이며 그쪽이 우선함
#
# 이 파일은 gitignore 되므로 사람마다 다른 값을 두어도 됨
# 아래 기본값은 램이 넉넉하지 않은 환경까지 고려한 최소 조합임
#
# ┌ 프로파일 ─────┬ 컨테이너 ────────────────────┬ 필수 ─┬ mem_limit ┬ 실사용 ─┐
# │ infra         │ kafka  redis                 │  필수 │    1.25G  │  0.73G  │
# │ platform      │ config  eureka  gateway      │  필수 │    1.50G  │  1.13G  │
# │ tools         │ kafka-ui                     │  권장 │    0.50G  │  0.35G  │
# │ observability │ prometheus loki zipkin       │  선택 │    2.00G  │  0.64G  │
# │               │ grafana                      │       │           │         │
# │ db            │ postgres                     │  비상 │    1.00G  │  0.50G  │
# │ pipeline      │ ingest  extract              │  선택 │           │         │
# │ edge          │ nginx                        │  선택 │           │         │
# │ app           │ 도메인 서비스                  │  선택 │           │         │
# └───────────────┴──────────────────────────────┴───────┴───────────┴─────────┘
#
# infra 가 필수인 이유
#   이벤트를 발행하거나 소비하는 서비스가 kafka 에 붙어야 하고
#   인증 토큰과 캐시가 redis 에 들어감
#
# platform 이 필수인 이유
#   config-server 가 없으면 DB 주소와 포트를 못 받아 서비스가 기동에 실패함
#   증상이 "포트가 8080 으로 뜨고 datasource 를 못 만듦" 이라
#   원인이 프로파일이라는 것이 드러나지 않으므로 반드시 함께 켤 것
#
# tools 를 권장하는 이유
#   이벤트가 실제로 토픽에 실렸는지 확인할 수 있는 유일한 수단임
#   "발행했는데 받는 쪽이 반응하지 않는다" 를 조사하는 첫 자리
#
# observability 를 기본에서 뺀 이유
#   개발 중 로그는 IntelliJ 콘솔에 그대로 나오므로 없어도 지장이 없음
#   대시보드나 추적 화면을 볼 때만 켜면 됨
#
# db 를 기본에서 뺀 이유
#   평소 개발은 팀 공용 EC2 PostgreSQL 을 씀 (수집 데이터를 공유해야 하므로)
#   빌드할 때 쓰는 DB 는 Testcontainers 가 따로 띄우므로 이 프로파일과 무관함
#   EC2 가 멎었거나 망 없이 작업할 때만 켤 것
#
# 상황별 조합
#   평소 개발                infra,platform,tools
#   대시보드·추적을 볼 때      infra,platform,tools,observability
#   EC2 를 못 쓸 때           infra,platform,tools,db
#   수집 배치를 돌릴 때        infra,platform,tools,pipeline
#   배포 형태로 확인할 때      infra,platform,observability,edge,app
#
# 램 16G 환경(예: M2 맥북에어 기본형)
#   기본값 그대로 둘 것. observability 는 볼 일이 있을 때만 켤 것
#   대략적인 배분은 macOS 4.5G + 컨테이너 2.2G + Docker VM 0.5G
#                  + IntelliJ·Gradle 3.0G + 서비스 1개 0.6G + 브라우저 1.0G
#   observability 까지 켠 채로 서비스를 2개 띄우면 여유가 1.5G 아래로 내려가
#   스왑이 돌기 시작하므로 권장하지 않음
#   Docker Desktop 은 Settings > Resources 에서 Memory 를 6G 로 낮출 것
#   기본값이 8G 라 그대로 두면 호스트 쪽이 부족해짐
#
# 램 32G 이상 환경
#   observability 를 함께 켜도 됨
#   COMPOSE_PROFILES=infra,platform,tools,observability
#
# 실측 방법
#   컨테이너   docker stats --no-stream
#   macOS      Activity Monitor > 메모리 탭의 "메모리 압력" 그래프
#              사용량 숫자보다 이 색이 기준임, 초록이면 정상
#   Windows    작업 관리자 > 성능 > 메모리의 "커밋됨"
COMPOSE_PROFILES=infra,platform,tools

# -----------------------------------------------------------------------------
# PostgreSQL
# -----------------------------------------------------------------------------
# 슈퍼유저이며 init 스크립트가 이 계정으로 DB 와 서비스 계정을 만듦
POSTGRES_USER=pawtrail
POSTGRES_PASSWORD=CHANGE_ME

# 서비스 전용 계정 10개가 공유하는 비밀번호임
# 계정을 나눈 목적은 누가 어느 DB 에 붙을 수 있는가를 권한으로 막는 것이지
# 비밀번호를 따로 두는 것이 아니므로 로컬에서는 하나로 둠
#
# 이 값은 init-db/01-databases.sh 가 계정을 만들 때 쓰임
# 스크립트에 비밀번호를 직접 적지 않는 이유는 .env 를 고쳤는데 스크립트 안 리터럴이
# 그대로 남아 두 값이 갈리는 사고를 원천 차단하기 위함임
SERVICE_DB_PASSWORD=CHANGE_ME

# -----------------------------------------------------------------------------
# Grafana
# -----------------------------------------------------------------------------
# 로컬 전용 계정임
# 익명 열람이 켜져 있어 대시보드를 보는 데는 로그인이 필요 없고
# 이 계정은 설정을 바꿀 때만 씀
GRAFANA_USER=admin
GRAFANA_PASSWORD=CHANGE_ME
